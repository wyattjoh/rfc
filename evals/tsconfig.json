{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "verbatimModuleSyntax": true
  },
  "include": ["config.ts", "src/**/*.ts", "test/**/*.ts"]
}
