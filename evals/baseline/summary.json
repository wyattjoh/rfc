  "tasks": [
    {
      "id": "q1",
      "title": "OAuth token exchange",
      "label": "Token exch.",
      "factors": ["noNumber"],
      "prompt": "When a client exchanges one security token for another using the standard OAuth 2.0 token exchange extension, what exact value must the grant_type request parameter be set to, and what does the issued_token_type response parameter indicate? Give the RFC number and the section for each answer.",
      "claims": 2
    },
    {
      "id": "q2",
      "title": "Retry-After and 429",
      "label": "Retry-After",
      "factors": ["rfcs3", "currency", "large", "noNumber"],
      "prompt": "Which RFC currently defines the HTTP Retry-After header field, which earlier RFC did it obsolete for that definition, and what two value formats does Retry-After allow? Separately, which RFC defines the 429 status code that commonly carries it? Give RFC numbers and sections.",
      "claims": 4
    },
    {
      "id": "q3",
      "title": "Encrypted DNS and padding",
      "label": "Encr. DNS",
      "factors": ["rfcs3", "noNumber"],
      "prompt": "For DNS over TLS and DNS over HTTPS, what default port or URI template does each use, and which RFC defines each one? Also identify the RFC that defines the EDNS(0) padding option used to mitigate traffic analysis for both, and the RFC that gives recommendations for choosing padding lengths. Give RFC numbers and sections.",
      "claims": 4
    },
    {
      "id": "q4",
      "title": "Content-Length + Transfer-Encoding",
      "label": "CL + TE",
      "factors": ["rfcs2", "currency", "compare", "noNumber"],
      "prompt": "What does the HTTP specification require a recipient to do when a message contains both a Content-Length header field and a Transfer-Encoding header field? Give the RFC number and section, state which earlier RFC that document obsoletes for this rule, and say whether the requirement changed between them.",
      "claims": 3
    },
    {
      "id": "q5",
      "title": "103 Early Hints",
      "label": "Early Hints",
      "factors": ["alias", "noNumber"],
      "prompt": "Which RFC defines the HTTP 103 Early Hints status code, in which section, what is that RFC's category, and what MUST a client not do with the header fields it carries? Give the RFC number and section.",
      "claims": 3
    },
    {
      "id": "q6",
      "title": "WebSocket handshake",
      "label": "WebSocket",
      "factors": ["noNumber"],
      "prompt": "In the WebSocket opening handshake, what fixed GUID string is concatenated with the Sec-WebSocket-Key value to compute Sec-WebSocket-Accept, which hash function is applied to that concatenation, and what value must the client send in the Sec-WebSocket-Version header field? Give the RFC number and section for each answer.",
      "claims": 3
    },
    {
      "id": "q7",
      "title": "TLS 1.3 currency",
      "label": "TLS 1.3",
      "factors": ["rfcs2", "currency", "appendix", "noNumber"],
      "prompt": "Which RFC currently defines TLS 1.3, and which earlier TLS 1.3 RFC does it obsolete? Which cipher suite must a TLS-compliant application implement, and what is that cipher suite's two-byte code point? Give RFC numbers and sections.",
      "claims": 4
    },
    {
      "id": "q8",
      "title": "QUIC Initial size and version",
      "label": "QUIC",
      "factors": ["noNumber"],
      "prompt": "What minimum UDP payload size must a QUIC client expand datagrams carrying Initial packets to, and what 32-bit version number identifies the version of QUIC defined in the core QUIC transport specification? Give the RFC number and section for each answer.",
      "claims": 2
    },
    {
      "id": "q9",
      "title": "SMTP line limits",
      "label": "SMTP",
      "factors": ["rfcs2", "currency", "noNumber"],
      "prompt": "Which RFC currently defines SMTP, which earlier RFC did it obsolete, and what are the maximum total lengths of an SMTP command line and of an SMTP reply line? Give RFC numbers and sections.",
      "claims": 4
    },
    {
      "id": "q10",
      "title": "JWT exp and alg none",
      "label": "JWT / JWS",
      "factors": ["rfcs2", "noNumber"],
      "prompt": "For JSON Web Tokens, what does the exp claim mean and what kind of value must it hold? Separately, what is a JWS that uses the alg value none called, and what must implementations do before accepting one? Give RFC numbers and sections.",
      "claims": 2
    },
    {
      "id": "q11",
      "title": "IPv6 Hop-by-Hop change",
      "label": "IPv6 HBH",
      "factors": ["rfcs2", "currency", "compare"],
      "prompt": "What did the original IPv6 specification, RFC 2460, require of nodes along a packet's delivery path regarding the Hop-by-Hop Options header? Which RFC obsoletes RFC 2460, did it change that requirement, and did the minimum link MTU change between the two? Give RFC numbers and sections.",
      "claims": 4
    },
    {
      "id": "q12",
      "title": "URI scheme ABNF",
      "label": "URI scheme",
      "factors": ["noNumber"],
      "prompt": "What is the ABNF rule for the scheme component of a generic URI, are scheme names case-sensitive, and what is the status of the RFC that defines that syntax? Give the RFC number and section.",
      "claims": 3
    },
    {
      "id": "q13",
      "title": "Structured Fields currency",
      "label": "Struct. fields",
      "factors": ["rfcs2", "currency", "alias", "noNumber"],
      "prompt": "Which RFC currently defines HTTP structured headers (structured field values), which earlier RFC did it obsolete, and which new bare item types did the newer RFC add? Give RFC numbers and sections.",
      "claims": 3
    },
    {
      "id": "q14",
      "title": "h2 / h3 ALPN",
      "label": "h2 / h3",
      "factors": ["rfcs3", "currency", "noNumber"],
      "prompt": "What ALPN protocol identifiers are used for HTTP/2 over TLS and for HTTP/3, and which RFC and section defines each? Which earlier RFC did the current HTTP/2 specification obsolete? Give RFC numbers and sections.",
      "claims": 3
    },
    {
      "id": "q15",
      "title": "501 vs 405",
      "label": "501 vs 405",
      "factors": ["large", "noNumber"],
      "prompt": "According to the HTTP semantics specification, how should an origin server respond to a request method it does not recognize, versus a method it recognizes and implements but that is not allowed for the target resource? What header field must the second kind of response include? Give the RFC number and sections.",
      "claims": 3
    }
  ],
