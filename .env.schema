# Varlock is the sole environment authority for the RFC CLI.
# ---

# @required @sensitive @type=string
TYPESAFE_API_KEY=

# @type=string @sensitive=false
# Production uses the exact model version accepted by the precision gate.
TYPESAFE_MODEL=jev-1.13.0

# @type=string @sensitive=false
RFC_POLICY_PRESET=precision-v1

# @type=string @sensitive=false
# Calibration deliberately starts from the provider alias before pinning.
RFC_EVALUATION_MODEL=jev-latest

# @type=string @sensitive=false
RFC_PINNED_MODEL=jev-1.13.0

# @type=boolean @sensitive=false
RFC_LIVE_EVALUATION=false

# @type=boolean @sensitive=false
# Set true only after a passing live report has a reviewed release attestation.
# The current build is pending live calibration, so this remains fail-closed.
RFC_AUTOMATIC_ANSWER_ENABLED=false

# @type=string @sensitive=false
RFC_EVALUATION_CACHE_DIRECTORY=.scratch/rfc-evaluation-cache

# @type=string @sensitive=false
RFC_EVALUATION_OUTPUT=.scratch/rfc-evaluation-report.json
