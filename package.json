{
  "name": "rfc",
  "private": true,
  "description": "Evidence-grounded IETF RFC research for CLIs and coding agents.",
  "keywords": [
    "ietf",
    "mcp",
    "pi-package",
    "rfc"
  ],
  "workspaces": [
    "packages/rfc-core",
    "packages/rfc",
    "packages/rfc-pi",
    "evals"
  ],
  "scripts": {
    "build": "bun run --cwd packages/rfc-core build && bun run --cwd packages/rfc build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "benchmark:topic": "bun run --cwd packages/rfc-core benchmark:topic",
    "test": "bun test packages evals",
    "typecheck": "bun run --cwd packages/rfc-core typecheck && bun run --cwd packages/rfc typecheck && bun run --cwd packages/rfc-pi typecheck && bun run --cwd evals typecheck",
    "hooks:install": "lefthook install",
    "eval": "bun evals/src/cli.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "packageManager": "bun@1.4.2",
  "pi": {
    "extensions": [
      "./packages/rfc-pi/extensions/rfc.ts"
    ],
    "skills": [
      "./packages/rfc-pi/skills"
    ]
  }
}
