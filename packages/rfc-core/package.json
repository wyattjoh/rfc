{
  "name": "@wyattjoh/rfc-core",
  "version": "0.1.0",
  "description": "Evidence-grounded IETF RFC research engine: live discovery, currency traversal, bounded evidence selection, and citation verification.",
  "keywords": [
    "citation",
    "effect",
    "evidence",
    "ietf",
    "rfc"
  ],
  "license": "MIT",
  "author": "Wyatt Johnson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyattjoh/rfc.git",
    "directory": "packages/rfc-core"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "benchmark:topic": "bun run benchmark/topic-discovery.ts"
  },
  "dependencies": {
    "@effect/ai-typesafe": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
