{
  "name": "@wyattjoh/rfc",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "rfc": "./src/bin.ts"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
