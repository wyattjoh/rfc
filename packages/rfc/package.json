{
  "name": "@wyattjoh/rfc",
  "version": "0.3.0",
  "description": "Agent-facing CLI and MCP server for evidence-grounded IETF RFC research.",
  "keywords": [
    "cli",
    "ietf",
    "mcp",
    "model-context-protocol",
    "rfc"
  ],
  "license": "MIT",
  "author": "Wyatt Johnson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyattjoh/rfc.git",
    "directory": "packages/rfc"
  },
  "bin": {
    "rfc": "./src/bin.ts"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/bin.ts --outdir dist --target bun",
    "test": "bun test",
    "evaluate:live": "cd ../.. && bun run packages/rfc/src/live-evaluation-bin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@modelcontextprotocol/server": "2.0.0",
    "@wyattjoh/rfc-core": "0.1.0",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
