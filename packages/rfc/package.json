    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.116",
    "@modelcontextprotocol/server": "2.0.0",
    "@wyattjoh/rfc-core": "workspace:*",
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
