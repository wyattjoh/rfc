{
  "name": "@wyattjoh/rfc-pi",
  "version": "0.2.1",
  "description": "Native Pi extension and lookup skill for evidence-grounded IETF RFC research.",
  "keywords": [
    "ietf",
    "pi-extension",
    "pi-package",
    "rfc"
  ],
  "license": "MIT",
  "author": "Wyatt Johnson",
